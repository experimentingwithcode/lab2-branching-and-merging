+    /**
+     * Remove *one* occurrence of <item> from this BST.
+     * Do nothing if <item> is not in the BST.
+     *
+     * @param item the item
+     */
     public void delete(int item) {
-
+        if (this.root == item) {
+            this.deleteRoot();
+        } else if (item < this.root) {
+            this.left.delete(item);
+        } else {
+            this.right.delete(item);
+        }
     }
 
